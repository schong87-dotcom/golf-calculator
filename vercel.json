{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/pomodoro-alarm-send.js": {
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "pomodoro-alarm", "retryAfterSeconds": 5 }
      ]
    }
  }
}
